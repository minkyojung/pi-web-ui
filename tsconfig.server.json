{
	"//": "The flags npm run typecheck used to pass on the command line. Split from the web project because the two share no lib or module settings.",
	"compilerOptions": {
		"module": "esnext",
		"target": "es2022",
		"moduleResolution": "bundler",
		"allowJs": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"types": ["node"]
	},
	"include": ["server.ts", "protocol.ts", "history.ts", "recorder.ts", "watcher.ts", "guard.ts", "documents.ts", "documentKinds.ts", "attach.ts", "naming.ts", "links.ts", "wikilink.ts", "linkIndex.ts", "properties.ts", "propertyTypes.ts", "propertyRegistry.ts", "search.ts","conversation.js", "prompts.ts", "toolModes.ts", "pty/spawnHelper.ts", "pty/flow.ts", "pty/env.ts", "pty/screen.ts", "pty/terminal.ts"]
}
