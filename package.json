{
  "name": "octave",
  "productName": "Octave",
  "version": "0.0.1",
  "description": "A folder of notes, with the pi coding agent at the table",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch server.ts\" \"vite\"",
    "dev:server": "tsx server.ts",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist-server/server.mjs",
    "build": "npm run notices && npm run build:client && npm run build:server",
    "app": "npm run build && electron .",
    "app:dev": "DEV_URL=http://localhost:5173 electron .",
    "pack": "npm run build && electron-builder --mac --arm64",
    "test": "node --test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "notices": "node scripts/notices.mjs",
    "contrast": "node scripts/contrast.mjs",
    "record": "node scripts/record.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "type": "module",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.9",
    "pi-web-access": "0.29.0",
    "react-resizable-panels": "^4.12.3",
    "typebox": "1.3.7",
    "unpdf": "^1.8.1",
    "ws": "^8.21.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "ai": "^7.0.92",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.5",
    "concurrently": "^10.0.5",
    "dompurify": "^3.4.14",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.40.0",
    "nanoid": "^6.0.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "streamdown": "^2.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "use-stick-to-bottom": "^1.1.6",
    "vite": "^8.2.2"
  },
  "overrides": {
    "pi-web-access": {
      "@earendil-works/pi-ai": "$@earendil-works/pi-coding-agent",
      "@earendil-works/pi-tui": "$@earendil-works/pi-coding-agent"
    }
  }
}
